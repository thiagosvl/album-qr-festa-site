---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/caveat/600.css";
import "@/styles/global.css";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppIcon from "@/components/WhatsAppIcon.astro";
import { NOME_MARCA, SITE_CONFIG, WHATSAPP_MENSAGENS, gerarLinkWhatsapp } from "@/constants/site.config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${NOME_MARCA}: seus convidados fotografam, a festa inteira vê`,
  description = "Os convidados escaneiam um QR Code, tiram foto com a moldura do tema da festa e ela aparece no mural e no telão na hora. Sem app e sem cadastro. A partir de R$ 49 por festa.",
} = Astro.props;

const whatsappFlutuante = gerarLinkWhatsapp(WHATSAPP_MENSAGENS.GERAL);
const imagemCompartilhamento = `${SITE_CONFIG.SITE_URL}/og-image.png`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffe4f0" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={NOME_MARCA} />
    <meta property="og:image" content={imagemCompartilhamento} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Logo da ${NOME_MARCA}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagemCompartilhamento} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <a
      href={whatsappFlutuante}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Falar no WhatsApp"
      class="fixed bottom-4 right-4 z-40 grid h-14 w-14 place-items-center rounded-full bg-whatsapp text-white shadow-suave hover:bg-whatsapp-escuro transition-transform hover:scale-105"
    >
      <WhatsAppIcon class="h-7 w-7" />
    </a>
  </body>
</html>
