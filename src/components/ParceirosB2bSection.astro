---
import WhatsAppIcon from "@/components/WhatsAppIcon.astro";
import {
  SECTION_IDS,
  SITE_LINKS,
  WHATSAPP_MENSAGENS,
  formatarMoedaCentavos,
  gerarLinkWhatsapp,
} from "@/constants/site.config";
import { ROTULOS_BOTAO } from "@/constants/copy";
import { NOME_MARCA } from "@/constants/site.config";
import type { CatalogoPlanoB2b } from "@/types/catalogo.types";

interface Props {
  planosB2b: CatalogoPlanoB2b[];
}

const { planosB2b } = Astro.props;
const linkParceria = gerarLinkWhatsapp(WHATSAPP_MENSAGENS.PARCERIA);
---

<section id={SECTION_IDS.PARCEIROS} class="bg-ameixa py-20 text-white sm:py-28">
  <div class="container grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-16">
    <div>
      <h2 class="text-[34px] font-extrabold leading-[1.05] sm:text-5xl">
        Buffet, fotógrafo ou decorador? Ofereça o álbum nas festas que você já atende.
      </h2>
      <p class="mt-5 max-w-md text-[17px] leading-relaxed text-white/75">
        Você assina um plano mensal com créditos, cria o álbum de cada cliente e entrega mais uma lembrança no seu serviço. O álbum usa a cor da sua marca, e a marca {NOME_MARCA} aparece num cantinho.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={linkParceria} target="_blank" rel="noopener noreferrer" class="botao-whatsapp">
          <WhatsAppIcon />
          {ROTULOS_BOTAO.FALAR_PARCERIA}
        </a>
        <a
          href={SITE_LINKS.PARCEIRO_LOGIN}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-white/25 bg-white/10 px-6 py-3 text-base font-bold text-white transition-colors hover:bg-white/20"
        >
          {ROTULOS_BOTAO.ENTRAR_PARCEIRO}
        </a>
      </div>
    </div>

    <div class="space-y-4">
      {planosB2b.map((plano) => (
        <article class="rounded-card bg-white/[0.07] p-7 ring-1 ring-white/15">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="text-2xl font-bold">{plano.nome}</h3>
            <p class="font-display text-3xl font-extrabold">
              {formatarMoedaCentavos(plano.preco_mensal_centavos)}
              <span class="text-base font-medium text-white/60">/mês</span>
            </p>
          </div>
          {plano.descricao && (
            <p class="mt-3 text-[15px] leading-relaxed text-white/75">{plano.descricao}</p>
          )}
          <dl class="mt-5 grid grid-cols-3 gap-4 border-t border-white/15 pt-5 text-sm">
            <div>
              <dt class="text-white/60">Créditos por mês</dt>
              <dd class="mt-1 font-display text-xl font-bold">{plano.creditos_mensais}</dd>
            </div>
            <div>
              <dt class="text-white/60">Evento Básico</dt>
              <dd class="mt-1 font-display text-xl font-bold">{plano.custo_creditos_basico} cr.</dd>
            </div>
            <div>
              <dt class="text-white/60">Evento Completo</dt>
              <dd class="mt-1 font-display text-xl font-bold">{plano.custo_creditos_completo} cr.</dd>
            </div>
          </dl>
          <p class="mt-4 text-sm text-white/60">
            Crédito extra: {formatarMoedaCentavos(plano.preco_credito_avulso_centavos)} cada.
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
