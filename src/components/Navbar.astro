---
import { Menu } from "lucide-astro";
import WhatsAppIcon from "@/components/WhatsAppIcon.astro";
import {
  SECTION_IDS,
  WHATSAPP_MENSAGENS,
  gerarLinkWhatsapp,
} from "@/constants/site.config";
import { ROTULOS_BOTAO } from "@/constants/copy";
import { NOME_MARCA } from "@/constants/site.config";

const links = [
  { rotulo: "Como funciona", href: `#${SECTION_IDS.COMO_FUNCIONA}` },
  { rotulo: "Temas", href: `#${SECTION_IDS.TEMAS}` },
  { rotulo: "Preços", href: `#${SECTION_IDS.PRECOS}` },
  { rotulo: "Para buffets e fotógrafos", href: `#${SECTION_IDS.PARCEIROS}` },
  { rotulo: "Dúvidas", href: `#${SECTION_IDS.DUVIDAS}` },
];
const linkWhatsapp = gerarLinkWhatsapp(WHATSAPP_MENSAGENS.GERAL);
---

<header class="sticky top-0 z-50 border-b border-ameixa/10 bg-papel/90 backdrop-blur-md">
  <div class="container flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center" aria-label={`${NOME_MARCA}, início`}>
      <img
        src="/marca/logo-horizontal.svg"
        alt={NOME_MARCA}
        width="137"
        height="44"
        class="h-11 w-auto"
        draggable="false"
      />
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium text-ameixa-suave lg:flex" aria-label="Seções da página">
      {links.map((link) => (
        <a href={link.href} class="transition-colors hover:text-uva">{link.rotulo}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={linkWhatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="botao-whatsapp hidden h-11 sm:inline-flex"
      >
        <WhatsAppIcon />
        {ROTULOS_BOTAO.QUERO_PARA_MINHA_FESTA}
      </a>

      <details class="group relative lg:hidden" data-menu-mobile>
        <summary
          class="grid h-11 w-11 cursor-pointer list-none place-items-center rounded-full bg-white ring-1 ring-ameixa/15"
          aria-label="Abrir menu"
        >
          <Menu class="h-5 w-5" />
        </summary>
        <nav
          class="absolute right-0 top-14 w-64 rounded-3xl bg-white p-3 shadow-palco ring-1 ring-ameixa/10"
          aria-label="Seções da página"
        >
          {links.map((link) => (
            <a href={link.href} class="block rounded-2xl px-4 py-3 text-[15px] font-medium hover:bg-uva-claro">
              {link.rotulo}
            </a>
          ))}
          <a
            href={linkWhatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="botao-whatsapp mt-2 w-full"
          >
            <WhatsAppIcon />
            {ROTULOS_BOTAO.QUERO_PARA_MINHA_FESTA}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-menu-mobile]");

  if (menu) {
    const fechar = (): void => {
      menu.open = false;
    };

    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", fechar));

    document.addEventListener("click", (evento) => {
      if (menu.open && evento.target instanceof Node && !menu.contains(evento.target)) {
        fechar();
      }
    });

    document.addEventListener("keydown", (evento) => {
      if (evento.key === "Escape" && menu.open) {
        fechar();
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>
