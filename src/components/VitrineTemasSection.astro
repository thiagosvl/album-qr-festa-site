---
import MiniMoldura from "@/components/MiniMoldura.astro";
import {
  DECOR_POR_CATEGORIA,
  LEGENDA_MOLDURA_PADRAO,
  ROTULO_CATEGORIA,
  TITULO_MOLDURA_PADRAO,
} from "@/constants/frames";
import {
  SECTION_IDS,
  WHATSAPP_MENSAGENS,
  gerarLinkWhatsapp,
} from "@/constants/site.config";
import type { CatalogoTema } from "@/types/catalogo.types";

interface Props {
  temas: CatalogoTema[];
}

const { temas } = Astro.props;
const linkSobMedida = gerarLinkWhatsapp(WHATSAPP_MENSAGENS.TEMA_SOB_MEDIDA);
import WhatsAppIcon from "@/components/WhatsAppIcon.astro";
---

<section id={SECTION_IDS.TEMAS} class="py-20 sm:py-28">
  <div class="container">
    <div class="max-w-2xl">
      <h2 class="text-[34px] font-extrabold leading-[1.05] sm:text-5xl">
        A moldura combina com o tema da sua festa.
      </h2>
      <p class="mt-5 text-[17px] leading-relaxed text-ameixa-suave">
        Cada moldura é criada para a sua festa, com nome, cores e detalhes do tema. Estes são alguns exemplos.
      </p>
    </div>
  </div>

  <div class="mt-12 overflow-x-auto pb-6 [scrollbar-width:thin]">
    <ul class="container flex snap-x snap-mandatory gap-5">
      {temas.map((tema) => (
        <li class="w-[200px] shrink-0 snap-start sm:w-[220px]">
          <MiniMoldura
            corA={tema.cor_primaria_padrao}
            corB={tema.cor_secundaria_padrao}
            titulo={TITULO_MOLDURA_PADRAO}
            legenda={LEGENDA_MOLDURA_PADRAO}
            decor={DECOR_POR_CATEGORIA[tema.categoria]}
          />
          <p class="mt-4 font-display text-lg font-bold leading-tight">{tema.nome}</p>
          <p class="text-sm text-ameixa-suave">{ROTULO_CATEGORIA[tema.categoria]}</p>
        </li>
      ))}

      <li class="w-[200px] shrink-0 snap-start sm:w-[220px]">
        <a
          href={linkSobMedida}
          target="_blank"
          rel="noopener noreferrer"
          class="flex aspect-[9/16] flex-col justify-between rounded-[28px] border-2 border-dashed border-ameixa/30 p-6 transition-colors hover:border-uva hover:bg-uva-claro"
        >
          <span class="font-display text-2xl font-extrabold leading-tight">Seu tema não está aqui?</span>
          <span class="text-[15px] leading-relaxed text-ameixa-suave">
            Criamos a moldura do jeito que você imaginou. Chame no WhatsApp e mande a ideia.
          </span>
          <span class="botao-whatsapp h-11 w-full px-4 text-sm">
            <WhatsAppIcon class="h-4 w-4" />
            Chamar no WhatsApp
          </span>
        </a>
      </li>
    </ul>
  </div>
</section>
