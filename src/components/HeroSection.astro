---
import { Smartphone, ShieldCheck, Eye } from "lucide-astro";
import WhatsAppIcon from "@/components/WhatsAppIcon.astro";
import HeroStage from "@/components/HeroStage.astro";
import {
  SITE_LINKS,
  WHATSAPP_MENSAGENS,
  formatarMoedaCentavos,
  gerarLinkWhatsapp,
} from "@/constants/site.config";
import { ROTULOS_BOTAO } from "@/constants/copy";
import type { CatalogoPacoteB2c } from "@/types/catalogo.types";

interface Props {
  pacotes: CatalogoPacoteB2c[];
}

const { pacotes } = Astro.props;
const menorPreco = pacotes.length
  ? Math.min(...pacotes.map((pacote) => pacote.preco_centavos))
  : null;
const linkWhatsapp = gerarLinkWhatsapp(WHATSAPP_MENSAGENS.GERAL);

const garantias = [
  { Icone: Smartphone, texto: "iPhone e Android, sem instalar app" },
  {
    Icone: ShieldCheck,
    texto: "Pague 50% para começar e 50% depois de aprovar a arte",
  },
];
---

<section class="overflow-hidden bg-algodao">
  <div class="container flex flex-col gap-6 py-7 sm:py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_600px] lg:items-center lg:gap-8 lg:py-20">
    <div class="contents lg:block">
      <div class="order-1 max-w-xl">
        <h1 class="text-[clamp(28px,8.6vw,40px)] font-extrabold leading-[1.04] sm:text-[52px] lg:text-[64px] lg:leading-[1.02]">
          Seus convidados tiram as fotos. A festa inteira vê na hora.
        </h1>
        <p class="mt-3 max-w-[34rem] text-[15px] leading-snug text-ameixa-suave sm:mt-6 sm:text-lg sm:leading-relaxed">
          Cada convidado escaneia o QR Code, escolhe a moldura do tema e envia. A foto aparece na hora no mural da festa e, no pacote Completo, também no telão.
        </p>

        <div class="mt-5 flex flex-col gap-3 sm:flex-row lg:mt-8">
          <a href={linkWhatsapp} target="_blank" rel="noopener noreferrer" class="botao-whatsapp">
            <WhatsAppIcon />
            {ROTULOS_BOTAO.QUERO_PARA_MINHA_FESTA}
          </a>
          <a href={SITE_LINKS.DEMO_CONVIDADO} target="_blank" rel="noopener noreferrer" class="botao-claro">
            <Eye class="h-5 w-5" />
            {ROTULOS_BOTAO.VER_DEMONSTRACAO}
          </a>
        </div>
      </div>

      <div class="order-3 max-w-xl lg:mt-8">
        <ul class="mt-6 space-y-3 text-[15px] text-ameixa-suave lg:mt-0">
          {garantias.map(({ Icone, texto }) => (
            <li class="flex items-start gap-3">
              <Icone class="mt-0.5 h-5 w-5 shrink-0 text-uva" />
              <span>{texto}</span>
            </li>
          ))}
          {menorPreco !== null && (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-uva text-[11px] font-bold text-white">R$</span>
              <span>A partir de {formatarMoedaCentavos(menorPreco)} por festa, sem mensalidade</span>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="order-2 lg:order-none">
      <HeroStage />
    </div>
  </div>
</section>
