---
import { Plus } from "lucide-astro";
import { SECTION_IDS } from "@/constants/site.config";
import { PERGUNTAS } from "@/constants/copy";
---

<section id={SECTION_IDS.DUVIDAS} class="py-20 sm:py-28">
  <div class="container grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-20">
    <h2 class="text-[34px] font-extrabold leading-[1.05] sm:text-5xl">
      Perguntas que todo mundo faz.
    </h2>

    <div class="divide-y divide-ameixa/15 border-y border-ameixa/15">
      {PERGUNTAS.map((item) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-xl font-bold leading-snug">
            <span>{item.pergunta}</span>
            <Plus class="h-6 w-6 shrink-0 text-uva transition-transform duration-200 group-open:rotate-45" />
          </summary>
          <p class="mt-3 max-w-2xl text-[16px] leading-relaxed text-ameixa-suave">{item.resposta}</p>
        </details>
      ))}
    </div>
  </div>
</section>
