---
import { Download, ImagePlus, Images, ShieldCheck, Smartphone, Tv } from "lucide-astro";
import { SECTION_IDS, SITE_LINKS } from "@/constants/site.config";
import {
  RECURSO_SEM_LIMITE,
  RECURSO_PAINEL,
  RECURSO_SALVAR,
  RECURSO_SEM_MOLDURA,
  RECURSO_TELAO,
  ROTULOS_BOTAO,
} from "@/constants/copy";
import MiniMoldura from "@/components/MiniMoldura.astro";
import { DEMO_TEMAS } from "@/constants/frames";
import type { CatalogoPacoteB2c } from "@/types/catalogo.types";

interface Props {
  pacotes: CatalogoPacoteB2c[];
}

const { pacotes } = Astro.props;
const rotacoes = ["-rotate-6", "rotate-2", "-rotate-3"];
const diasGaleria = pacotes.length
  ? Math.max(...pacotes.map((pacote) => pacote.dias_galeria_ativa))
  : 90;
---

<section id={SECTION_IDS.RECURSOS} class="py-20 sm:py-28">
  <div class="container">
    <h2 class="max-w-2xl text-[34px] font-extrabold leading-[1.05] sm:text-5xl">
      Tudo o que você precisa antes, durante e depois da festa.
    </h2>

    <div class="mt-12 grid gap-4 lg:grid-cols-6">
      <article class="relative overflow-hidden rounded-card bg-ameixa p-8 text-white lg:col-span-4 lg:row-span-2 lg:p-10">
        <Tv class="h-8 w-8 text-gema" />
        <h3 class="mt-6 text-3xl font-bold sm:text-4xl">{RECURSO_TELAO.titulo}</h3>
        <p class="mt-4 max-w-md text-[17px] leading-relaxed text-white/80">{RECURSO_TELAO.descricao}</p>
        <a
          href={SITE_LINKS.DEMO_TELAO}
          target="_blank"
          rel="noopener noreferrer"
          class="botao-rosa mt-8"
        >
          {ROTULOS_BOTAO.VER_TELAO}
        </a>
        <div class="pointer-events-none absolute -bottom-10 right-6 hidden gap-3 sm:flex" aria-hidden="true">
          {DEMO_TEMAS.slice(0, 3).map((tema, posicao) => (
            <MiniMoldura
              class={`w-28 ${rotacoes[posicao]}`}
              corA={tema.corA}
              corB={tema.corB}
              titulo={tema.titulo}
              legenda={tema.legenda}
              decor={tema.decor}
            />
          ))}
        </div>
      </article>

      <article class="rounded-card bg-gema p-7 lg:col-span-2">
        <ShieldCheck class="h-7 w-7" />
        <h3 class="mt-5 text-2xl font-bold">{RECURSO_PAINEL.titulo}</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-ameixa/80">{RECURSO_PAINEL.descricao}</p>
      </article>

      <article class="rounded-card bg-algodao p-7 lg:col-span-2">
        <ImagePlus class="h-7 w-7 text-rosa" />
        <h3 class="mt-5 text-2xl font-bold">{RECURSO_SEM_MOLDURA.titulo}</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-ameixa/80">{RECURSO_SEM_MOLDURA.descricao}</p>
      </article>

      <article class="rounded-card bg-uva-claro p-7 lg:col-span-2">
        <Smartphone class="h-7 w-7 text-uva" />
        <h3 class="mt-5 text-xl font-bold">{RECURSO_SALVAR.titulo}</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-ameixa/80">{RECURSO_SALVAR.descricao}</p>
      </article>

      <article class="rounded-card p-7 ring-1 ring-ameixa/15 lg:col-span-2">
        <Download class="h-7 w-7 text-uva" />
        <h3 class="mt-5 text-xl font-bold">{diasGaleria} dias de galeria no ar</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-ameixa/80">
          A galeria fica no ar para todo mundo rever as fotos, e você pode baixar todas de uma vez, com um toque em “Baixar tudo”. Se quiser mais tempo no ar, dá para estender por um ano.
        </p>
      </article>

      <article class="rounded-card p-7 ring-1 ring-ameixa/15 lg:col-span-2">
        <Images class="h-7 w-7 text-uva" />
        <h3 class="mt-5 text-xl font-bold">{RECURSO_SEM_LIMITE.titulo}</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-ameixa/80">{RECURSO_SEM_LIMITE.descricao}</p>
      </article>
    </div>
  </div>
</section>
