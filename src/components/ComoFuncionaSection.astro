---
import { QrCode } from "lucide-astro";
import { SECTION_IDS } from "@/constants/site.config";
import { LUGARES_DO_QR, PASSOS } from "@/constants/copy";
---

<section id={SECTION_IDS.COMO_FUNCIONA} class="bg-uva-escuro py-20 text-white sm:py-28">
  <div class="container grid gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 class="text-[34px] font-extrabold leading-[1.05] sm:text-5xl">
        Do pedido ao álbum no ar em três passos.
      </h2>
      <p class="mt-5 max-w-md text-[17px] leading-relaxed text-white/80">
        Você não precisa montar nada. A gente cuida das molduras e do QR Code, e você só aprova.
      </p>

      <div class="mt-10 max-w-md rounded-card bg-white/10 p-6">
        <p class="flex items-center gap-2 font-display text-lg font-bold">
          <QrCode class="h-5 w-5 text-gema" />
          Onde o QR Code fica na festa
        </p>
        <ul class="mt-4 grid grid-cols-1 gap-x-6 gap-y-2 text-[15px] text-white/85 sm:grid-cols-2">
          {LUGARES_DO_QR.map((lugar) => (
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-gema"></span>
              {lugar}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <ol class="space-y-0">
      {PASSOS.map((passo, indice) => (
        <li class="grid grid-cols-[4.5rem_1fr] gap-x-4 border-t border-white/20 py-9 first:border-t-0 first:pt-0 sm:grid-cols-[6.5rem_1fr] sm:gap-x-6">
          <span class="font-display text-[64px] font-extrabold leading-none text-gema sm:text-[88px]">
            {indice + 1}
          </span>
          <div>
            <h3 class="text-2xl font-bold leading-tight sm:text-[28px]">{passo.titulo}</h3>
            <p class="mt-3 max-w-lg text-[17px] leading-relaxed text-white/80">{passo.descricao}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
