---
import { Check, Minus, X } from "lucide-astro";
import { SECTION_IDS } from "@/constants/site.config";
import {
  COMPARATIVO_LINHAS,
  ComparativoValor,
  type ComparativoCelula,
} from "@/constants/copy";

const estiloPorValor: Record<ComparativoValor, string> = {
  [ComparativoValor.SIM]: "bg-uva text-white",
  [ComparativoValor.PARCIAL]: "bg-gema text-ameixa",
  [ComparativoValor.NAO]: "bg-ameixa/10 text-ameixa-suave",
};

const iconePorValor = {
  [ComparativoValor.SIM]: Check,
  [ComparativoValor.PARCIAL]: Minus,
  [ComparativoValor.NAO]: X,
};

const colunas = [
  { chave: "grupoWhatsapp", rotulo: "Grupo do WhatsApp", destaque: false },
  { chave: "fotografo", rotulo: "Só o fotógrafo", destaque: false },
  { chave: "album", rotulo: "Álbum QR Festa", destaque: true },
] as const;
---

<section id={SECTION_IDS.COMPARATIVO} class="py-20 sm:py-28">
  <div class="container">
    <div class="max-w-2xl">
      <h2 class="text-[34px] font-extrabold leading-[1.05] sm:text-5xl">
        O grupo do WhatsApp não guarda a sua festa.
      </h2>
      <p class="mt-5 text-[17px] leading-relaxed text-ameixa-suave">
        A foto fica perdida no meio das mensagens, comprimida, e só quem está no grupo vê. O fotógrafo faz um ótimo trabalho, mas é um olhar só. O álbum junta o olhar de todo mundo que estava lá.
      </p>
    </div>

    <div class="mt-12 overflow-hidden rounded-card ring-1 ring-ameixa/10">
      <div class="hidden grid-cols-[1.25fr_1fr_1fr_1.2fr] bg-ameixa/[0.04] text-sm font-semibold md:grid">
        <div class="px-6 py-4"></div>
        {colunas.map((coluna) => (
          <div class={`px-6 py-4 ${coluna.destaque ? "bg-uva-claro text-uva-profundo" : "text-ameixa-suave"}`}>
            {coluna.rotulo}
          </div>
        ))}
      </div>

      {COMPARATIVO_LINHAS.map((linha) => (
        <div class="grid border-t border-ameixa/10 md:grid-cols-[1.25fr_1fr_1fr_1.2fr]">
          <div class="px-6 pb-2 pt-5 text-[17px] font-semibold md:py-5">{linha.criterio}</div>
          {colunas.map((coluna) => {
            const celula: ComparativoCelula = linha[coluna.chave];
            const Icone = iconePorValor[celula.valor];
            return (
              <div class={`flex items-center gap-3 px-6 py-2 md:py-5 ${coluna.destaque ? "bg-uva-claro/60 pb-5 md:pb-5" : ""}`}>
                <span class={`grid h-6 w-6 shrink-0 place-items-center rounded-full ${estiloPorValor[celula.valor]}`}>
                  <Icone class="h-3.5 w-3.5" />
                </span>
                <span class="text-[15px]">
                  <span class="mr-1 text-ameixa-suave md:hidden">{coluna.rotulo}:</span>
                  {celula.texto}
                </span>
              </div>
            );
          })}
        </div>
      ))}
    </div>

    <p class="mt-6 max-w-2xl text-[15px] text-ameixa-suave">
      O álbum não substitui o fotógrafo. Ele mostra a festa pelos olhos dos convidados, e os dois se completam.
    </p>
  </div>
</section>
