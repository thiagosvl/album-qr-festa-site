---
import FrameArt from "@/components/FrameArt.astro";
import { ID_SIMBOLO_CENA } from "@/constants/hero-stage.constants";
import type { DecorTipo } from "@/constants/frames";

interface Props {
  corA: string;
  corB: string;
  titulo: string;
  legenda: string;
  decor: DecorTipo;
  thumbUrl?: string | null;
  molduraPreviewUrl?: string | null;
  class?: string;
}

const {
  corA,
  corB,
  titulo,
  legenda,
  decor,
  thumbUrl = null,
  molduraPreviewUrl = null,
  class: classe = "",
} = Astro.props;
---

<div class={`rounded-[28px] bg-ameixa p-2 shadow-suave ${classe}`}>
  <div
    class="relative aspect-[9/16] overflow-hidden rounded-[22px] bg-algodao"
    style={`--fa:${corA};--fb:${corB}`}
  >
    {thumbUrl ? (
      <img
        src={thumbUrl}
        alt={titulo}
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
      />
    ) : (
      <svg viewBox="0 0 270 480" class="absolute inset-0 h-full w-full" aria-hidden="true">
        <use href={`#${ID_SIMBOLO_CENA}`}></use>
      </svg>
    )}
    {molduraPreviewUrl ? (
      <img
        src={molduraPreviewUrl}
        alt={titulo}
        loading="lazy"
        class="pointer-events-none absolute inset-0 h-full w-full object-contain"
      />
    ) : (
      <FrameArt
        herdarCores
        class="absolute inset-0 h-full w-full"
        corA={corA}
        corB={corB}
        titulo={titulo}
        legenda={legenda}
        decor={decor}
      />
    )}
  </div>
</div>
