---
import { DecorTipo } from "@/constants/frames";

interface Props {
  corA: string;
  corB: string;
  titulo: string;
  legenda: string;
  decor: DecorTipo;
  class?: string;
  herdarCores?: boolean;
}

const {
  corA,
  corB,
  titulo,
  legenda,
  decor,
  class: classe = "",
  herdarCores = false,
} = Astro.props;
const estiloCores = herdarCores ? undefined : `--fa:${corA};--fb:${corB}`;
const decoracoes = Object.values(DecorTipo);
---

<svg
  viewBox="0 0 270 480"
  class={classe}
  style={estiloCores}
  aria-hidden="true"
  data-frame-art
>
  <rect x="6" y="6" width="258" height="468" rx="26" fill="none" stroke="var(--fa)" stroke-width="10"></rect>
  <rect x="15" y="15" width="240" height="450" rx="19" fill="none" stroke="var(--fb)" stroke-width="2.5" stroke-dasharray="1 7" stroke-linecap="round"></rect>

  <rect x="40" y="26" width="190" height="46" rx="23" fill="#fff"></rect>
  <text x="135" y="58" text-anchor="middle" font-family="Bricolage Grotesque Variable, Inter, sans-serif" font-weight="800" font-size="25" fill="var(--fa)" data-frame-titulo>{titulo}</text>

  <rect x="66" y="418" width="138" height="34" rx="17" fill="var(--fb)"></rect>
  <text x="135" y="441" text-anchor="middle" font-family="Bricolage Grotesque Variable, Inter, sans-serif" font-weight="700" font-size="16" fill="#fff" data-frame-legenda>{legenda}</text>

  {decoracoes.map((tipo) => (
    <g data-decor={tipo} hidden={tipo !== decor}>
      {tipo === DecorTipo.BALOES && (
        <>
          <path d="M34 150 C 32 190 40 230 52 262" stroke="#fff" stroke-width="1.5" fill="none"></path>
          <ellipse cx="32" cy="120" rx="21" ry="26" fill="var(--fa)"></ellipse>
          <ellipse cx="62" cy="136" rx="18" ry="23" fill="#ffd23f"></ellipse>
          <ellipse cx="238" cy="116" rx="21" ry="26" fill="var(--fb)"></ellipse>
          <ellipse cx="210" cy="132" rx="17" ry="22" fill="var(--fa)"></ellipse>
          <path d="M238 144 C 242 190 232 230 224 262" stroke="#fff" stroke-width="1.5" fill="none"></path>
        </>
      )}
      {tipo === DecorTipo.ESTRELAS && (
        <>
          <path d="M40 110 l7 15 16 2 -12 11 3 16 -14 -8 -14 8 3 -16 -12 -11 16 -2z" fill="#ffd23f"></path>
          <path d="M228 150 l5 11 12 1.500 -9 8 2.500 12 -10.500 -6 -10.500 6 2.500 -12 -9 -8 12 -1.500z" fill="#fff"></path>
          <path d="M60 372 l5 11 12 1.500 -9 8 2.500 12 -10.500 -6 -10.500 6 2.500 -12 -9 -8 12 -1.500z" fill="#fff"></path>
          <path d="M222 360 l7 15 16 2 -12 11 3 16 -14 -8 -14 8 3 -16 -12 -11 16 -2z" fill="#ffd23f"></path>
          <circle cx="205" cy="96" r="3" fill="#fff"></circle>
          <circle cx="80" cy="330" r="3" fill="#ffd23f"></circle>
        </>
      )}
      {tipo === DecorTipo.FLORES && (
        <>
          <g transform="translate(40 120)">
            <circle cx="0" cy="-12" r="10" fill="var(--fa)"></circle>
            <circle cx="12" cy="-4" r="10" fill="var(--fa)"></circle>
            <circle cx="7" cy="10" r="10" fill="var(--fa)"></circle>
            <circle cx="-7" cy="10" r="10" fill="var(--fa)"></circle>
            <circle cx="-12" cy="-4" r="10" fill="var(--fa)"></circle>
            <circle cx="0" cy="0" r="7" fill="#ffd23f"></circle>
          </g>
          <g transform="translate(232 380)">
            <circle cx="0" cy="-12" r="10" fill="var(--fb)"></circle>
            <circle cx="12" cy="-4" r="10" fill="var(--fb)"></circle>
            <circle cx="7" cy="10" r="10" fill="var(--fb)"></circle>
            <circle cx="-7" cy="10" r="10" fill="var(--fb)"></circle>
            <circle cx="-12" cy="-4" r="10" fill="var(--fb)"></circle>
            <circle cx="0" cy="0" r="7" fill="#ffd23f"></circle>
          </g>
          <circle cx="224" cy="118" r="7" fill="#fff"></circle>
          <circle cx="52" cy="368" r="7" fill="#fff"></circle>
          <circle cx="206" cy="150" r="4" fill="var(--fa)"></circle>
        </>
      )}
      {tipo === DecorTipo.CORACOES && (
        <>
          <path d="M44 132 c-14 -12 -8 -30 6 -30 c6 0 10 4 12 8 c2 -4 6 -8 12 -8 c14 0 20 18 6 30 l-18 16z" fill="var(--fa)"></path>
          <path d="M214 372 c-12 -10 -7 -26 5 -26 c5 0 9 3 10 7 c1 -4 5 -7 10 -7 c12 0 17 16 5 26 l-15 14z" fill="var(--fb)"></path>
          <path d="M214 120 c-8 -7 -5 -18 4 -18 c4 0 6 2 7 5 c1 -3 4 -5 7 -5 c9 0 12 11 4 18 l-11 10z" fill="#fff"></path>
          <path d="M52 366 c-8 -7 -5 -18 4 -18 c4 0 6 2 7 5 c1 -3 4 -5 7 -5 c9 0 12 11 4 18 l-11 10z" fill="#fff"></path>
        </>
      )}
    </g>
  ))}
</svg>
